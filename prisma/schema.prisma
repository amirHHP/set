generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(uuid())
  name          String
  username      String           @unique
  email         String?          @unique
  passwordHash  String
  salt          String
  role          String           @default("user") // "admin", "coach", or "user"
  gender        String?          @default("female") // "female" or "male"
  height        Float?           // cm
  targetMuscles String?          // JSON array of muscle IDs / names
  createdAt     DateTime         @default(now())

  // Coach specific fields
  coachCode           String?          @unique
  coachBio            String?
  coachPhone          String?
  coachWelcomeMessage String?

  // Trainee relation
  coachId             String?
  coach               User?            @relation("CoachTrainees", fields: [coachId], references: [id], onDelete: SetNull)
  trainees            User[]           @relation("CoachTrainees")

  // Coach notes
  notesSent           CoachNote[]      @relation("CoachNotesSent")
  notesReceived       CoachNote[]      @relation("CoachNotesReceived")

  // Relations
  sizes        BodySize[]
  programs     WorkoutProgram[]
  logs         WorkoutLog[]

  @@index([coachCode])
  @@index([coachId])
}

model CoachNote {
  id        String   @id @default(uuid())
  coachId   String
  coach     User     @relation("CoachNotesSent", fields: [coachId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   User     @relation("CoachNotesReceived", fields: [traineeId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())

  @@index([coachId])
  @@index([traineeId])
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Int
  image       String   // Base64 or image URL
  category    String   // "supplement" | "equipment" | "clothing"
  createdAt   DateTime @default(now())
}

model BodySize {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight      Float    // kg
  waist       Float    // cm
  hips        Float    // cm
  arms        Float    // cm
  chest       Float    // cm
  photoUrl    String?  // Base64 image
  aiFeedback  String?  // Farsi feedback from AI
  createdAt   DateTime @default(now())
}

model WorkoutProgram {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programJson String   // JSON containing structure of exercises and sets
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  logs        WorkoutLog[]
}

model WorkoutLog {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId         String
  program           WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  date              String         // "YYYY-MM-DD"
  completedSetsJson String         // JSON mapping exercise+set to checked boolean
  isCompleted       Boolean        @default(false)
  createdAt         DateTime       @default(now())
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   // Markdown content
  summary     String
  coverImage  String
  createdAt   DateTime @default(now())
}

model SystemConfig {
  key   String @id
  value String
}
